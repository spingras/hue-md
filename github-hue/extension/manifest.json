{
  "manifest_version": 3,
  "name": "Hue MD for GitHub",
  "version": "0.2.2",
  "description": "Renders live Hue MD color spans, badges, and styled callout boxes on GitHub",
  "author": "spingras",
  "homepage_url": "https://spingras.github.io/hue-md",
  "icons": {
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "css": [
        "hue.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}
