#!/bin/sh
# Git pre-commit hook for Hue Markdown
# Writes the GitHub Markdown copy of each staged *.hue.md file (notes.hue.md -> notes.md).
# It only overwrites a .md file that hue-md generated (it starts with a
# "Generated by hue-md" line), so a hand-written README.md is never replaced.

if ! command -v npx >/dev/null 2>&1; then
  exit 0
fi

STAGED_HUE_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.hue\.md$')

if [ -z "$STAGED_HUE_FILES" ]; then
  exit 0
fi

echo "[hue-hook] Syncing staged .hue.md files to GitHub Markdown..."

for FILE in $STAGED_HUE_FILES; do
  TARGET="${FILE%.hue.md}.md"
  NAME=$(basename "$FILE")
  [ -f "$FILE" ] || continue

  if [ -f "$TARGET" ] && ! head -c 40 "$TARGET" | grep -q '<!-- Generated by hue-md from '; then
    echo "[hue-hook]   ! Skipped $TARGET: it was not generated by hue-md"
    continue
  fi

  TMP="$TARGET.hue-tmp"
  if npx --yes hue-md downgrade "$FILE" -o "$TMP" >/dev/null 2>&1; then
    { printf '<!-- Generated by hue-md from %s. Edit %s instead of this file. -->\n\n' "$NAME" "$NAME"; cat "$TMP"; } > "$TARGET"
    rm -f "$TMP"
    git add "$TARGET"
    echo "[hue-hook]   ✓ Synced $TARGET"
  else
    rm -f "$TMP"
    echo "[hue-hook]   ! Could not convert $FILE (is Node.js installed?)"
  fi
done

exit 0
