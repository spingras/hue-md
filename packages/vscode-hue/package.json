{
  "name": "hue-md",
  "displayName": "Hue MD",
  "description": "Rich color spans, diff spans, keycaps, progress bars, multi-state tasks, and styled callout boxes (single or side-by-side) for Markdown (.hue.md) with live preview and editor highlighting",
  "version": "0.2.3",
  "publisher": "spingras",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "homepage": "https://spingras.github.io/hue-md",
  "bugs": {
    "url": "https://github.com/spingras/hue-md/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/spingras/hue-md.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Formatters",
    "Programming Languages",
    "Other"
  ],
  "type": "module",
  "keywords": [
    "markdown",
    "hue",
    "callout",
    "preview",
    "colors",
    "boxes"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:markdown",
    "onLanguage:hue-markdown"
  ],
  "contributes": {
    "languages": [
      {
        "id": "hue-markdown",
        "aliases": [
          "Hue Markdown",
          "Hue",
          "hue"
        ],
        "extensions": [
          ".hue.md"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./media/icon.png",
          "dark": "./media/icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "hue-markdown",
        "scopeName": "source.hue-markdown",
        "path": "./syntaxes/hue-markdown.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.markdown": "markdown"
        }
      },
      {
        "scopeName": "hue.markdown.injection",
        "path": "./syntaxes/hue-injection.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ]
      }
    ],
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./media/hue.css"
    ],
    "snippets": [
      {
        "language": "hue-markdown",
        "path": "./snippets/hue.json"
      },
      {
        "language": "markdown",
        "path": "./snippets/hue.json"
      }
    ],
    "commands": [
      {
        "command": "hue.openPreviewSideBySide",
        "title": "Hue: Open Side-by-Side Preview",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "hue.downgradeToGfm",
        "title": "Hue: Convert to GitHub Alert Markdown (.md)"
      },
      {
        "command": "hue.insertBox",
        "title": "Hue: Insert Box..."
      },
      {
        "command": "hue.wrapSelectionInBox",
        "title": "Hue: Wrap Selection in Box..."
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "hue.openPreviewSideBySide",
          "when": "editorLangId == hue-markdown || editorLangId == markdown",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "hue.openPreviewSideBySide",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == hue-markdown || editorLangId == markdown"
      },
      {
        "command": "hue.openPreviewSideBySide",
        "key": "ctrl+shift+v",
        "mac": "shift+cmd+v",
        "when": "editorLangId == hue-markdown || editorLangId == markdown"
      }
    ]
  },
  "scripts": {
    "build": "node build.js",
    "test": "node --test test/extension.test.js"
  }
}
