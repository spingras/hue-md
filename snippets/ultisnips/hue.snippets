# Hue MD snippets for UltiSnips. Generated by scripts/build-snippets.js from packages/vscode-hue/snippets/hue.json; do not edit.

snippet info "Insert a Hue Info/Tip box (blue)" b
+-- info ${1:Title}
| ${2:Content}
+--
endsnippet

