# Hue Markdown UltiSnips

snippet info "Hue Info Box" b
+-- info ${1:Title}
| ${0:Content}
+--
endsnippet

snippet warn "Hue Warning Box" b
+-- warn ${1:Title}
| ${0:Content}
+--
endsnippet

snippet ok "Hue Success Box" b
+-- ok ${1:Title}
| ${0:Content}
+--
endsnippet

snippet note "Hue Note Box" b
+-- note ${1:Title}
| ${0:Content}
+--
endsnippet

snippet danger "Hue Danger Box" b
+-- danger ${1:Title}
| ${0:Content}
+--
endsnippet

snippet span "Hue Inline Span" w
{${1:info}: ${2:text}}
endsnippet
