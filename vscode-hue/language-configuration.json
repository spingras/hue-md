{
  "comments": {
    "blockComment": ["<!--", "-->"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" },
    { "open": "`", "close": "`" }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"],
    ["`", "`"]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*(?:┌|╭|\\+)(?:─+|-+)",
      "end": "^\\s*(?:[└╰][─\\-]+[┘╯]?|\\+[─\\-]+\\+?)\\s*$"
    }
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(\\||│)\\s+.+",
      "action": {
        "indentAction": "none",
        "appendText": "| "
      }
    }
  ]
}
