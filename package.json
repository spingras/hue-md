{
  "name": "hue-md",
  "version": "0.2.2",
  "description": "Hue Markdown (.hue.md): readable-raw color spans, diff spans, keycaps, progress bars, multi-state tasks, and callout boxes (single or side-by-side) — parser, CLI, terminal viewer & slides, and GitHub downgrade",
  "author": "spingras",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spingras/hue-md.git"
  },
  "homepage": "https://spingras.github.io/hue-md/",
  "bugs": {
    "url": "https://github.com/spingras/hue-md/issues"
  },
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "hue-md": "bin/hue-md.js",
    "md-hue": "bin/hue-md.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./core": "./src/core.js",
    "./ansi": "./md-hue/src/ansi.js",
    "./downgrade": "./md-hue/src/downgrade.js",
    "./html": "./md-hue/src/index.js",
    "./css": "./dist/hue.css"
  },
  "files": [
    "bin",
    "src",
    "dist/hue-md.css",
    "dist/hue.css",
    "md-hue/src",
    "md-hue/bin",
    "spec/spec.md"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.js\" \"md-hue/test/**/*.test.js\" \"vscode-hue/test/**/*.test.js\" \"github-hue/test/**/*.test.js\"",
    "build:css": "node scripts/build-css.js",
    "demo": "node scripts/build-hero.js && node scripts/generate-readme-assets.js && node scripts/render-demo.js",
    "build:screenshots": "node scripts/build-screenshots.js",
    "build:claude": "node scripts/build-claude-plugin.js"
  },
  "keywords": [
    "markdown",
    "hue",
    "hue-md",
    "markdown-it",
    "markdown-it-plugin",
    "color",
    "callout",
    "box",
    "cli",
    "terminal",
    "ansi",
    "github"
  ],
  "dependencies": {
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "esbuild": "0.24.2"
  }
}
